# Godot
.godot/
/android/
*.translation
export/
# export_presets.cfg is versioned (Loop 28: the package build needs it). Since Godot 4.1 signing secrets go
# to .godot/export_credentials.cfg, ignored with .godot/; never put a password in export_presets.cfg.

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Local user data must never be committed (it lives in the OS user data folder)
/data/
*.sqlite3
*.sqlite3-*
api_token
# Secrets: dotenvx. The encrypted .env IS committed; private keys never are.
.env.keys
.env.*.keys
.env.local
.env.*.local

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local listening samples (generated, not shipped)
samples/

# How-to screenshots: regenerated by tools/howto.sh; the site keeps the WebP copies (public/assets/howto)
docs/screenshots/howto/
dist/
